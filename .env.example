GROQ_API_KEY=your_api_key
# Optional: defaults to llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile #preferably this model for better usage 
MYSQL_USER=root # preferably use root as it is the admin user of the database and have overall access.
MYSQL_PASSWORD=your_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=your_preferred_database